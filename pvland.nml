! PV-LAND parameters of the offline model (version 2): namelist &pvland.
! The same namelist is read by ARPS (arps.input, sfcphy = 5).
! Each parameter is described on its line; a parameter left out keeps
! its default value (module pvland_nml in core/module_pvland.f90).
! pv_park_opt: 0 = the column is in the PV park, 2 = no PV panels (natural
! ground only); pv_park_i1..j2 locate the park on the ARPS grid (offline,
! only column (1,1) is computed).
! Generated by ../arps5.3.4_PVLAND_v2/scripts_v2/make_pvland_nml.py
!
! Site and run parameters of the offline model: namelist &offline_site at
! the end of this file (in ARPS they come from &soil_ebm of arps.input).
!
! Usage: ./pv_land.exe [forcing.csv [pvland.nml]]

 &pvland

   ! --- Options ---
   vf_update_opt        = 0,         ! View factors, sky view factors, radiosity LU factors and tilt-derived geometry: 0 = computed once at initialisation (fixed panels), 1 = recomputed at every PV-LAND time step (moving panels)

   ! --- Location of the PV park (offline: the single column is in the park or not) ---
   pv_park_opt          = 0,         ! 0 = PV park over the whole domain, 1 = rectangle pv_park_i1:pv_park_i2 x pv_park_j1:pv_park_j2, 2 = no PV park (natural ground only, with the PV-LAND soil physics)
   pv_park_i1           = 1,         ! First global x index (scalar point) of the PV park (pv_park_opt = 1)
   pv_park_i2           = 99999,     ! Last global x index of the PV park, clipped to the domain (pv_park_opt = 1)
   pv_park_j1           = 1,         ! First global y index (scalar point) of the PV park (pv_park_opt = 1)
   pv_park_j2           = 99999,     ! Last global y index of the PV park, clipped to the domain (pv_park_opt = 1)

   ! --- Park geometry ---
   pv_L                 = 3.23,      ! Panel length along the slope (m)
   pv_a                 = 3.4,       ! Inter-row spacing (m)
   pv_beta_deg          = 24.0,      ! Panel tilt angle from the horizontal (deg)
   pv_h_PV              = 1.9,       ! Height of the panel top edge above the ground (m)
   pv_theta_0_deg       = -3.0,      ! Park orientation angle used by the wind profile (deg)
   pv_az_park           = 177.0,     ! Meteorological azimuth faced by the panel fronts (deg)

   ! --- Natural vegetation of the park (wind profile, version 2) ---
   pv_zd_nat            = 0.285,     ! Displacement height of the natural vegetation alone (m); its roughness z0 is roufns
   pv_ztz0_nat          = 0.1,       ! Ratio zt/z0 of thermal to momentum roughness, natural ground -> canopy air (-)
   pv_ztz0_air          = 1.0,       ! Ratio zt/z0, canopy air and air above the panels -> reference level (-)

   ! --- Radiative properties ---
   pv_albedo_nat        = 0.22,      ! Albedo of the natural ground surface (-)
   pv_albedo_PVf        = 0.11,      ! Albedo of the panel front (-)
   pv_albedo_PVb        = 0.11,      ! Albedo of the panel back (-)
   pv_emiss_nat         = 0.98,      ! Emissivity of the natural ground surface (-)
   pv_emiss_PVf         = 0.81,      ! Emissivity of the panel front (-)
   pv_emiss_PVb         = 0.845,     ! Emissivity of the panel back (-)

   ! --- Convection on the panel faces ---
   pv_C_for_f           = 6.80,      ! Forced convection, front face: h = C_for_f * U_PVa**p_for_f (W/m2/K)
   pv_C_for_b           = 6.80,      ! Forced convection, back face: h = C_for_b * U_can**p_for_b (W/m2/K)
   pv_p_for_f           = 0.80,      ! Wind exponent of the forced convection, front face (-)
   pv_p_for_b           = 0.80,      ! Wind exponent of the forced convection, back face (-)
   pv_fac_h_free        = 2.50,      ! Scaling of the free convection of Kaplani & Kaplanis (2014) (-)

   ! --- Obukhov length (computed by PV-LAND from its own fluxes) ---
   pv_tau_L             = 300.0,     ! Relaxation time of 1/L towards the instantaneous value (s), 0 = no relaxation
   pv_L_floor           = 0.5,       ! Minimum |L| (m)

   ! --- PV module, 3-node thermal model ---
   pv_delta_PVf         = 3.8e-3,    ! Equivalent thickness of the front node (m)
   pv_delta_cell        = 0.225e-3,  ! Equivalent thickness of the cell node (m)
   pv_delta_PVb         = 1.1e-3,    ! Equivalent thickness of the back node (m)
   pv_rho_cp_PVf        = 1.580e6,   ! Volumetric heat capacity of the front node (J/m3/K)
   pv_rho_cp_cell       = 1.577e6,   ! Volumetric heat capacity of the cell node (J/m3/K)
   pv_rho_cp_PVb        = 1.776e6,   ! Volumetric heat capacity of the back node (J/m3/K)
   pv_k_glass           = 1.8,       ! Thermal conductivity of the glass (W/m/K)
   pv_k_EVA             = 0.35,      ! Thermal conductivity of the EVA (W/m/K)
   pv_k_backsheet       = 0.20,      ! Thermal conductivity of the backsheet (W/m/K)
   pv_delta_glass       = 3.2e-3,    ! Thickness of the glass sub-layer (m)
   pv_delta_EVA_top     = 0.6e-3,    ! Thickness of the top EVA sub-layer (m)
   pv_delta_EVA_bot     = 0.6e-3,    ! Thickness of the bottom EVA sub-layer (m)
   pv_delta_backsheet   = 0.5e-3,    ! Thickness of the backsheet sub-layer (m)
   pv_eta_STC           = 0.18,      ! PV efficiency at standard test conditions (25 C, 1000 W/m2) (-)
   pv_gamma_PV          = 0.0045,    ! Temperature coefficient of the PV efficiency (1/K)

   ! --- Soil of the PV-LAND points (soilebm_frc_pv/evapflx_pv; a negative value keeps the ARPS table, soilcst.inc) ---
   pv_cgv               = 3.0e-5,    ! Thermal coefficient of the vegetation cgv (K m2/J); ARPS: 1.5e-5
   pv_wsat              = 0.315,     ! Saturated volumetric moisture content (m3/m3), all soil types
   pv_wfc               = 0.135,     ! Field capacity (m3/m3), all soil types
   pv_wwlt              = 0.05,      ! Wilting point (m3/m3), all soil types
   pv_rsmin             = 70.0,      ! Minimum stomatal resistance (s/m), all vegetation types
   pv_wref              = 0.219,     ! Moisture threshold of the transpiration stress and of the bare-soil evaporation (m3/m3)
   pv_drain_opt         = 1,         ! Drainage of the deep reservoir: 0 = off, 1 = on (c3 * max(w2 - wfc, 0) / tau)
   pv_c3_drain          = 0.1,       ! Drainage coefficient c3 (-)
 /

!-----------------------------------------------------------------------
! Site and run parameters of the offline model (not read by ARPS: there,
! dtsfc, styp, vtyp, lai0, roufns0, veg0 are in &soil_ebm of arps.input
! and the initial soil state comes from the ARPS soil initialisation).
!-----------------------------------------------------------------------

 &offline_site
   forcing_file   = 'recorded_data_2025.csv', ! Forcing CSV file (the 1st command-line argument overrides it)
   dt_forcing     = 1800.,   ! Time interval between two rows of the forcing file (s)
   dtsfc          = 2.,      ! PV-LAND time step (s)
   styp           = 1,       ! Soil type of the site (soilcst.inc; its parameters may be overridden in &pvland)
   vtyp           = 3,       ! Vegetation type of the site (soilcst.inc)
   lai0           = 2.0,     ! Leaf area index (m2/m2)
   roufns0        = 0.073,   ! Roughness length of the natural surface z0_nat (m)
   veg0           = 0.95,    ! Vegetation fraction (-)
   tsoil_sfc_ini  = -999.,   ! Initial surface soil temperature (C); < -100: air temperature of the first forcing row
   tsoil_deep_ini = 20.7,    ! Initial deep soil temperature (C)
   qsoil_sfc_ini  = 0.125,   ! Initial surface soil moisture (m3/m3)
   qsoil_deep_ini = 0.115,   ! Initial deep soil moisture (m3/m3)
   wetcanp_ini    = 0.,      ! Initial canopy water amount (m)
 /
